# Copy this file to .env and fill in your values. .env is never committed.

# openFDA API key (free): https://open.fda.gov/apis/authentication/
# Raises the limit from 1,000 to 120,000 requests per day.
# Paste the key only: no quotes, no spaces.
OPENFDA_API_KEY=

# Optional: Gradio server settings (read by Gradio itself)
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
